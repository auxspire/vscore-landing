{
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/sync-football-data?job=all", "schedule": "*/15 * * * *" }
  ],
  "redirects": [
    {
      "source": "/worldcup",
      "destination": "/worldcup/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/worldcup/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/worldcup/index.html"
    }
  ]
}

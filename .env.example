# Environment variables (names only — set values in Vercel / local .env)

## World Cup frontend (Vite — not NEXT_PUBLIC_*)
VITE_SUPABASE_URL=https://vscor-supabase.auxspire.com
VITE_SUPABASE_ANON_KEY=

## Scoring app (Vite — same Supabase project as worldcup)
# BASE_PATH=/app/ is set in vite.config.ts; optional override for local dev
VITE_SCORING_FUNCTION_SLUG=make-server-845a157a

## API server / sync (secret)
SUPABASE_URL=https://vscor-supabase.auxspire.com
SUPABASE_SERVICE_ROLE_KEY=
WORLD_CUP26_BASE_URL=https://worldcup26.ir
WORLD_CUP26_JWT_TOKEN=
WORLD_CUP26_AUTH_EMAIL=
WORLD_CUP26_AUTH_PASSWORD=
WORLD_CUP26_DAILY_SOFT_LIMIT=200
CRON_SECRET=

## Setup script (optional)
API_BASE_URL=http://localhost:8080
DATABASE_URL=
